msgstr ""
"ອັບໂຫຼດ core dump ແລະ ເຮັດ retracing ຢູ່ເຄື່ອງອື່ນບໍ? (ມັນອາດຈະມີຂໍ້ມູນຄວາມລັບ). ຖ້າທ່ານຕອບ "
"'ບໍ່', stack trace ຈະຖືກສ້າງຂຶ້ນໃນເຄື່ອງ. ການ retracing ໃນເຄື່ອງອາດຕ້ອງດາວໂຫຼດຂໍ້ມູນ "
"debuginfo ຈຳນວນຫຼາຍ"

#: ../src/cli/abrtcli/cli/retrace.py:71
msgid "Remote retracing"
msgstr "ການ retracing ທາງໄກ"

#: ../src/cli/abrtcli/cli/retrace.py:74
msgid "Local retracing"
msgstr "ການ retracing ໃນເຄື່ອງ"

#: ../src/cli/abrtcli/cli/status.py:17
msgid "show only the number of problems"
msgstr "ສະແດງສະເພາະຈຳນວນບັນຫາ"

#: ../src/cli/abrtcli/cli/status.py:19
msgid "only show output if at least one problem is found"
msgstr "ສະແດງເອົາພຸດສະເພາະເມື່ອພົບຢ່າງໜ້ອຍໜຶ່ງບັນຫາ"

#: ../src/cli/abrtcli/cli/status.py:40
msgid "ABRT has detected a problem. For more information, run “abrt list{}”"
msgstr "ABRT ກວດພົບບັນຫາແລ້ວ. ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ໃຫ້ແລ່ນ “abrt list{}”"

#: ../src/plugins/analyze_CCpp.xml.in.h:1
msgid ""
"Send core dump to remote retrace server for analysis or perform local "
"analysis if the remote analysis fails"
msgstr ""
"ສົ່ງ core dump ໄປຍັງເຊີບເວີ retrace ທາງໄກເພື່ອວິເຄາະ ຫຼື ວິເຄາະໃນເຄື່ອງຖ້າການວິເຄາະທາງໄກລົ້ມເຫຼ"
"ວ"

#: ../src/plugins/analyze_CCpp.xml.in.h:2
msgid ""
"Uploads coredump to a server, which generates backtrace and returns it. If "
"user doesn't want to upload his coredump to anywhere the event performs "
"local analysis. Local analysis is run event if remote analysis fails. Pros: "
"no need for debuginfo downloads. Retrace server's database of debuginfos is "
"more complete. Retrace server may generate better backtraces. Cons: coredump "
"you upload contains all the data from the crashed program, including your "
"private data, if any."
msgstr ""
"ອັບໂຫຼດ coredump ໄປຍັງເຊີບເວີ, ເຊິ່ງຈະສ້າງ backtrace ແລະ ສົ່ງຄືນ. ຖ້າຜູ້ໃຊ້ບໍ່ຕ້ອງການອັບໂຫຼດ "
"coredump ຂອງຕົນໄປບ່ອນອື່ນ ລະບົບຈະວິເຄາະໃນເຄື່ອງແທນ. ການວິເຄາະໃນເຄື່ອງຈະເຮັດວຽກເຖິງແມ່ນວ່າການ"
"ວິເຄາະທາງໄກລົ້ມເຫຼວ. ຂໍ້ດີ: ບໍ່ຕ້ອງດາວໂຫຼດ debuginfo. ຖານຂໍ້ມູນ debuginfos ຂອງເຊີບເວີ "
"Retrace ສົມບູນກວ່າ. ເຊີບເວີ Retrace ອາດຈະສ້າງ backtraces ໄດ້ດີກວ່າ. ຂໍ້ເສຍ: coredump ທີ່ທ່າ"
"ນອັບໂຫຼດມີຂໍ້ມູນທັງໝົດຈາກໂປຣແກຣມທີ່ຂັດຂ້ອງ, ລວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານນຳ (ຖ້າມີ)."

#: ../src/plugins/analyze_VMcore.xml.in.h:1
msgid "Analyze VM core"
msgstr "ວິເຄາະ VM core"

#: ../src/plugins/analyze_VMcore.xml.in.h:2
msgid "Install kernel debuginfo packages, generate kernel log and oops message"
msgstr "ຕິດຕັ້ງແພັກເກດ debuginfo ຂອງ kernel, ສ້າງບັນທຶກ kernel ແລະ ຂໍ້ຄວາມ oops"

#: ../src/plugins/analyze_VMcore.xml.in.h:3
msgid ""
"Needs to install kernel debuginfo packages, which might take significant "
"time, and take up disk space."
msgstr ""
"ຈຳເປັນຕ້ອງຕິດຕັ້ງແພັກເກດ debuginfo ຂອງ kernel, ເຊິ່ງອາດໃຊ້ເວລາຫຼາຍ, ແລະ ກິນພື້ນທີ່ດິດ."

#: ../src/plugins/collect_GConf.xml.in.h:1
msgid "Collect GConf configuration"
msgstr "ເກັບກຳການຕັ້ງຄ່າ GConf"

#: ../src/plugins/collect_GConf.xml.in.h:2
msgid "Save configuration from application's GConf directory"
msgstr "ບັນທຶກການຕັ້ງຄ່າຈາກໄດເຣັກທໍຣີ GConf ຂອງແອັບພລິເຄຊັນ"

#: ../src/plugins/collect_GConf.xml.in.h:3
msgid ""
"Runs gconftool-2 --recursive-list /apps/executable and saves it as "
"'gconf_subtree' element."
msgstr ""
"ແລ່ນຄຳສັ່ງ gconftool-2 --recursive-list /apps/executable ແລະ ບັນທຶກເປັນອົງປະກອບ "
"'gconf_subtree'."

#: ../src/plugins/collect_vimrc_system.xml.in.h:1
msgid "Collect system-wide vim configuration files"
msgstr "ເກັບກຳໄຟລ໌ການຕັ້ງຄ່າ vim ຂອງລະບົບ"

#: ../src/plugins/collect_vimrc_system.xml.in.h:2
msgid "Save /etc/vimrc and /etc/gvimrc"
msgstr "ບັນທຶກ /etc/vimrc ແລະ /etc/gvimrc"

#: ../src/plugins/collect_vimrc_system.xml.in.h:3
msgid ""
"Checks if there are vimrc and gvimrc files in /etc and saves them as "
"system_vimrc and system_gvimrc, respectively."
msgstr ""
"ກວດສອບວ່າມີໄຟລ໌ vimrc ແລະ gvimrc ໃນ /etc ຫຼື ບໍ່ ແລະ ບັນທຶກເປັນ system_vimrc ແລະ "
"system_gvimrc ຕາມລຳດັບ."

#: ../src/plugins/collect_vimrc_user.xml.in.h:1
msgid "Collect yours vim configuration files"
msgstr "ເກັບກຳໄຟລ໌ການຕັ້ງຄ່າ vim ຂອງທ່ານ"

#: ../src/plugins/collect_vimrc_user.xml.in.h:2
msgid "Save .vimrc and .gvimrc from your home directory"
msgstr "ບັນທຶກ .vimrc ແລະ .gvimrc ຈາກໄດເຣັກທໍຣີ home ຂອງທ່ານ"

#: ../src/plugins/collect_vimrc_user.xml.in.h:3
msgid ""
"Checks if there are .vimrc and .gvimrc in your home directory and saves them "
"as user_vimrc and user_gvimrc, respectively."
msgstr ""
"ກວດສອບວ່າມີ .vimrc ແລະ .gvimrc ໃນໄດເຣັກທໍຣີ home ຂອງທ່ານຫຼືບໍ່ ແລະ ບັນທຶກເປັນ user_vimrc ແ"
"ລະ user_gvimrc ຕາມລຳດັບ."

#: ../src/plugins/post_report.xml.in.h:1
msgid "Post report"
msgstr "ປະກາດລາຍງານ"

#: ../src/plugins/post_report.xml.in.h:2
msgid "Executed after the reporting is finished"
msgstr "ເຮັດວຽກຫຼັງຈາກການລາຍງານສຳເລັດ"

#: ../src/plugins/post_report.xml.in.h:3
msgid "Used for updating of the databases"
msgstr "ໃຊ້ສຳລັບການອັບເດດຖານຂໍ້ມູນ"
