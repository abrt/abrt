#: ../src/plugins/abrt-action-install-debuginfo.in:190
#, c-format
msgid ""
"Usage: %s [-vy] [--ids=BUILD_IDS_FILE] [--pkgmgr=(yum|dnf)]\n"
"       [--tmpdir=TMPDIR] [--cache=CACHEDIR[:DEBUGINFODIR1:DEBUGINFODIR2...]] "
"[--size_mb=SIZE]\n"
"       [-e, --exact=PATH[:PATH...]]\n"
"       [--releasever=RELEASEVER] [--repo=PATTERN]\n"
"\n"
"Installs debuginfos for all build-ids listed in BUILD_IDS_FILE\n"
"to CACHEDIR, using TMPDIR as temporary staging area.\n"
"Old files in CACHEDIR are deleted until it is smaller than SIZE.\n"
"\n"
"Reads configuration from /etc/abrt/plugins/CCpp.conf\n"
"\n"
"    -v          Be verbose\n"
"    -y          Noninteractive, assume 'Yes' to all questions\n"
"    --ids       Default: build_ids\n"
"    --tmpdir    Default: @LARGE_DATA_TMP_DIR@/abrt-tmp-debuginfo-"
"RANDOM_SUFFIX\n"
"    --cache     Colon separated list of directories. The first one is used "
"for\n"
"                saving installed debuginfos.\n"
"                Default: /var/cache/abrt-di\n"
"    --size_mb   Default: 4096\n"
"    --pkgmgr    Default: PackageManager from CCpp.conf or 'dnf'\n"
"    -e,--exact  Download only specified files\n"
"    --repo      Pattern to use when searching for repos.\n"
"                Default: *debug*\n"
"    --releasever RELEASEVER\n"
"                Pass this OS version to package managers.\n"
msgstr ""
"ການນຳໃຊ້: %s [-vy] [--ids=BUILD_IDS_FILE] [--pkgmgr=(yum|dnf)]\n"
"       [--tmpdir=TMPDIR] [--cache=CACHEDIR[:DEBUGINFODIR1:DEBUGINFODIR2...]] "
"[--size_mb=SIZE]\n"
"       [-e, --exact=PATH[:PATH...]]\n"
"       [--releasever=RELEASEVER] [--repo=PATTERN]\n"
"\n"
"ຕິດຕັ້ງ debuginfos ສຳລັບ build-ids ທັງໝົດທີ່ມີໃນ BUILD_IDS_FILE\n"
"ໄປຍັງ CACHEDIR, ໂດຍໃຊ້ TMPDIR ເປັນພື້ນທີ່ຊົ່ວຄາວ.\n"
"ໄຟລ໌ເກົ່າໃນ CACHEDIR ຈະຖືກລຶບຈົນກວ່າຈະນ້ອຍກວ່າ SIZE.\n"
"\n"
"ອ່ານການຕັ້ງຄ່າຈາກ /etc/abrt/plugins/CCpp.conf\n"
"\n"
"    -v          ສະແດງລາຍລະອຽດ\n"
"    -y          ບໍ່ຖາມ, ຕອບ 'ແມ່ນ' ສຳລັບທຸກຄຳຖາມ\n"
"    --ids       ຄ່າເລີ່ມຕົ້ນ: build_ids\n"
"    --tmpdir    ຄ່າເລີ່ມຕົ້ນ: @LARGE_DATA_TMP_DIR@/abrt-tmp-debuginfo-"
"RANDOM_SUFFIX\n"
"    --cache     ລາຍຊື່ໄດເຣັກທໍຣີທີ່ແຍກດ້ວຍຈ້ຳສອງເມັດ. ອັນທຳອິດໃຊ້ສຳລັບ\n"
"                ບັນທຶກ debuginfos ທີ່ຕິດຕັ້ງແລ້ວ.\n"
"                ຄ່າເລີ່ມຕົ້ນ: /var/cache/abrt-di\n"
"    --size_mb   ຄ່າເລີ່ມຕົ້ນ: 4096\n"
"    --pkgmgr    ຄ່າເລີ່ມຕົ້ນ: PackageManager ຈາກ CCpp.conf ຫຼື 'dnf'\n"
"    -e,--exact  ດາວໂຫຼດສະເພາະໄຟລ໌ທີ່ລະບຸ\n"
"    --repo      ຮູບແບບທີ່ໃຊ້ຄົ້ນຫາ repos.\n"
"                ຄ່າເລີ່ມຕົ້ນ: *debug*\n"
"    --releasever RELEASEVER\n"
"                ສົ່ງເວີຊັນ OS ນີ້ໃຫ້ຕົວຈັດການແພັກເກດ.\n"

#: ../src/plugins/abrt-action-install-debuginfo.in:290
msgid "Exiting on user command"
msgstr "ກຳລັງອອກຕາມຄຳສັ່ງຜູ້ໃຊ້"

#: ../src/plugins/abrt-action-install-debuginfo-to-abrt-cache.c:43
msgid ""
"& [-y] [-i BUILD_IDS_FILE|-i -] [-e PATH[:PATH]...]\n"
"\t[-r REPO]\n"
"\n"
"Installs debuginfo packages for all build-ids listed in BUILD_IDS_FILE to\n"
"ABRT system cache."
msgstr ""
"& [-y] [-i BUILD_IDS_FILE|-i -] [-e PATH[:PATH]...]\n"
"\t[-r REPO]\n"
"\n"
"ຕິດຕັ້ງແພັກເກດ debuginfo ສຳລັບ build-ids ທັງໝົດໃນ BUILD_IDS_FILE ລົງໃນ\n"
"ABRT system cache."

#: ../src/plugins/abrt-action-install-debuginfo-to-abrt-cache.c:68
msgid "Noninteractive, assume 'Yes' to all questions"
msgstr "ບໍ່ຖາມ, ຕອບ 'ແມ່ນ' ສຳລັບທຸກຄຳຖາມ"

#: ../src/plugins/abrt-action-install-debuginfo-to-abrt-cache.c:69
msgid "- means STDIN, default: build_ids"
msgstr "- ໝາຍເຖິງ STDIN, ຄ່າເລີ່ມຕົ້ນ: build_ids"

#: ../src/plugins/abrt-action-install-debuginfo-to-abrt-cache.c:70
msgid "Download only specified files"
msgstr "ດາວໂຫຼດສະເພາະໄຟລ໌ທີ່ລະບຸ"

#: ../src/plugins/abrt-action-install-debuginfo-to-abrt-cache.c:71
msgid "Pattern to use when searching for repos, default: *debug*"
msgstr "ຮູບແບບທີ່ໃຊ້ຄົ້ນຫາ repos, ຄ່າເລີ່ມຕົ້ນ: *debug*"

#: ../src/plugins/abrt-action-install-debuginfo-to-abrt-cache.c:72
msgid "Ignored option"
msgstr "ຕົວເລືອກທີ່ຖືກລະເລີຍ"

#: ../src/plugins/abrt-action-install-debuginfo-to-abrt-cache.c:73
msgid "OS release version"
msgstr "ເວີຊັນ OS ທີ່ປ່ອຍ"

#: ../src/plugins/abrt-action-perform-ccpp-analysis.in:62
msgid ""
"Ok to upload core dump? (It may contain sensitive data). If your answer is "
"'No', a stack trace will be generated locally. (It may download a huge "
"amount of data)."
msgstr ""
"ຕົກລົງທີ່ຈະອັບໂຫຼດ core dump ບໍ? (ມັນອາດຈະມີຂໍ້ມູນທີ່ເປັນຄວາມລັບ). ຖ້າທ່ານຕອບ 'ບໍ່', stack trace "
"ຈະຖືກສ້າງຢູ່ໃນເຄື່ອງ. (ອາດຈະດາວໂຫຼດຂໍ້ມູນຈຳນວນຫຼາຍ)."

#: ../src/plugins/abrt-action-perform-ccpp-analysis.in:71
msgid ""
"Do you want to generate a stack trace locally? (It may download a huge "
"amount of data but reporting can't continue without stack trace)."
msgstr ""
"ທ່ານຕ້ອງການສ້າງ stack trace ຢູ່ໃນເຄື່ອງບໍ? (ອາດຈະດາວໂຫຼດຂໍ້ມູນຈຳນວນຫຼາຍແຕ່ການລາຍງານຈະສືບຕໍ່ບໍ່ໄດ້"
"ຖ້າບໍ່ມີ stack trace)."

#: ../src/plugins/abrt-action-trim-files.c:222
msgid ""
"& [-v] [-d SIZE:DIR]... [-f SIZE:DIR]... [-p DIR] [FILE]...\n"
"\n"
"Deletes problem dirs (-d) or files (-f) in DIRs until they are smaller than "
"SIZE.\n"
"FILEs are preserved (never deleted)."
msgstr ""
"& [-v] [-d SIZE:DIR]... [-f SIZE:DIR]... [-p DIR] [FILE]...\n"
"\n"
"ລຶບໄດເຣັກທໍຣີບັນຫາ (-d) ຫຼື ໄຟລ໌ (-f) ໃນ DIR ຕ່າງໆຈົນກວ່າຈະນ້ອຍກວ່າ SIZE.\n"
"FILE ຈະຖືກເກັບໄວ້ (ບໍ່ຖືກລຶບ)."

#: ../src/plugins/abrt-action-trim-files.c:236
